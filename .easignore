# Keep root workspace manifests needed by npm workspaces; omit generated/dependency files.
node_modules/
**/node_modules/
.pnp
.pnp.js
.git/
**/.git/
.next/
**/.next/
out/
.expo/
**/.expo/
dist/
**/dist/
build/
**/build/
web-build/
**/web-build/
*.tsbuildinfo
next-env.d.ts

# Never send local or service credentials to EAS.
.env
.env.*
**/.env
**/.env.*
*.local
**/*.local
*.pem
**/*.pem
credentials.json
**/credentials.json

# Local build artifacts.
*.apk
*.aab
