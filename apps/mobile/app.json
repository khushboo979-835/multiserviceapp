{
  "expo": {
    "name": "Inisha",
    "slug": "inisha-city-service",
    "owner": "inshaservice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inishacityservice.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app requires access to your location to find nearby service providers and track bookings in real time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.inishacity.service",
      "versionCode": 6,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAOOch1BG92R9iYYnuyMEwEq0kj9uy5ysE"
        }
      }
    },
    "updates": {
      "url": "https://u.expo.dev/37f13d43-b36d-44d2-80d1-21b8bfe0d9ea",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://inishacityservice.com"
        }
      ],
      "expo-asset",
      "expo-updates"
    ],
    "scheme": "inishacityservice",
    "extra": {
      "router": {
        "origin": "https://inishacityservice.com"
      },
      "eas": {
        "projectId": "37f13d43-b36d-44d2-80d1-21b8bfe0d9ea"
      }
    }
  }
}
