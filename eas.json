{
  "cli": {
    "version": ">= 24.11.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://multiserviceapp-4pdw.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://multiserviceapp-4pdw.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://multiserviceapp-4pdw.onrender.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://multiserviceapp-4pdw.onrender.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
