rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow full read access to public services catalog
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles: Allow users to read/write their own profiles, demo profiles, and admin
    match /users/{userId} {
      allow read, write: if true;
    }

    // Bookings collection: Allow read/write for bookings
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Provider profiles
    match /provider_profiles/{providerId} {
      allow read, write: if true;
    }

    // Fallback for all other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
