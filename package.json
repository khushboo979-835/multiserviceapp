{
  "name": "multi-service-app",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "workspaces": [
    "apps/mobile",
    "apps/backend",
    "apps/admin"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/backend",
    "start": "node apps/backend/dist/server.js",
    "backend:build": "npm run build --workspace=apps/backend",
    "backend:dev": "npm run dev --workspace=apps/backend",
    "backend:start": "npm run start --workspace=apps/backend",
    "admin:dev": "npm run dev --workspace=apps/admin",
    "admin:build": "npm run build --workspace=apps/admin",
    "admin:start": "npm run start --workspace=apps/admin",
    "mobile:start": "npm run start --workspace=apps/mobile",
    "mobile:android": "npm run android --workspace=apps/mobile",
    "mobile:ios": "npm run ios --workspace=apps/mobile",
    "mobile:web": "npm run web --workspace=apps/mobile",
    "mobile:build:apk": "cd apps/mobile && npx eas-cli build --platform android --profile preview"
  },
  "dependencies": {
    "array-timsort": "^1.0.3",
    "expo-asset": "~12.0.13",
    "expo-system-ui": "^57.0.4",
    "react-native-webview": "^13.15.0"
  }
}
